// VS Code REST Client. Copy the master key from the server startup log.
@base_url = http://127.0.0.1:8080
@master_key = PASTE_MASTER_API_KEY
@api_key = {{master_key}}
@index_id = 0
@vector_index_id = 1
@key_to_revoke = PASTE_ORDINARY_API_KEY

### Health
GET {{base_url}}/api/v1/live

### Create an optional isolated key
POST {{base_url}}/api/v1/apikey
apikey: {{master_key}}
Content-Type: application/json

{}

### List indexes in this key's scope
GET {{base_url}}/api/v1/apikey
apikey: {{api_key}}

### Create a lexical index; text is stored and indexed by default
POST {{base_url}}/api/v1/index
apikey: {{api_key}}
Content-Type: application/json

{"index_name":"documents","schema":[{"field":"body","field_type":"Text"},{"field":"category","field_type":"String16","filterable":true}]}

### Index information
GET {{base_url}}/api/v1/index/{{index_id}}
apikey: {{api_key}}

### Write one document (an array writes a batch)
POST {{base_url}}/api/v1/index/{{index_id}}/doc
apikey: {{api_key}}
Content-Type: application/json

[{"body":"hello database","category":"guide"},{"body":"hello world","category":"note"}]

### Search immediately, before committing
POST {{base_url}}/api/v1/index/{{index_id}}/query
apikey: {{api_key}}
Content-Type: application/json

{"query":"hello"}

### Filter, project and match any term
POST {{base_url}}/api/v1/index/{{index_id}}/query
apikey: {{api_key}}
Content-Type: application/json

{"query":"database world","operator":"or","fields":["body"],"facet_filter":[{"String16":{"field":"category","filter":["guide"]}}]}

### Browse without text; omit total counting
POST {{base_url}}/api/v1/index/{{index_id}}/query
apikey: {{api_key}}
Content-Type: application/json

{"count":false,"length":10,"result_sort":[{"field":"category","order":"Ascending"}]}

### Persist pending writes
PATCH {{base_url}}/api/v1/index/{{index_id}}
apikey: {{api_key}}

### Read a document; the fields body is optional
GET {{base_url}}/api/v1/index/{{index_id}}/doc/0
apikey: {{api_key}}
Content-Type: application/json

{"fields":["body"]}

### Iterate live documents; defaults to 10 with stored fields
POST {{base_url}}/api/v1/index/{{index_id}}/iterator
apikey: {{api_key}}
Content-Type: application/json

{}

### Replace one document (an array of tuples replaces a batch)
PATCH {{base_url}}/api/v1/index/{{index_id}}/doc
apikey: {{api_key}}
Content-Type: application/json

[0,{"body":"updated database","category":"guide"}]

### Create a hybrid index; vectors default to F32/Cosine, without quantization
POST {{base_url}}/api/v1/index
apikey: {{api_key}}
Content-Type: application/json

{"index_name":"hybrid","schema":[{"field":"body","field_type":"Text"},{"field":"vector","field_type":"Json","index_vector":true}],"vector":{"dimensions":3}}

### Supply external embeddings; no model runs in the server
POST {{base_url}}/api/v1/index/{{vector_index_id}}/doc
apikey: {{api_key}}
Content-Type: application/json

{"body":"hello database","vector":[1,0,0]}

### Vector-only search; no query string required
POST {{base_url}}/api/v1/index/{{vector_index_id}}/query
apikey: {{api_key}}
Content-Type: application/json

{"query_vector":[1,0,0]}

### Text plus vector selects hybrid search
POST {{base_url}}/api/v1/index/{{vector_index_id}}/query
apikey: {{api_key}}
Content-Type: application/json

{"query":"database","query_vector":[1,0,0]}

### Delete by internal document ID
DELETE {{base_url}}/api/v1/index/{{index_id}}/doc/1
apikey: {{api_key}}

### Delete by nonempty text query, or send a numeric ID / array of IDs
DELETE {{base_url}}/api/v1/index/{{index_id}}/doc
apikey: {{api_key}}
Content-Type: application/json

{"query":"database"}

### Remove all documents: raw clear, without JSON quotes
DELETE {{base_url}}/api/v1/index/{{index_id}}/doc
apikey: {{api_key}}
Content-Type: text/plain

clear

### Delete the index
DELETE {{base_url}}/api/v1/index/{{index_id}}
apikey: {{api_key}}

### Revoke a key and delete its indexes
DELETE {{base_url}}/api/v1/apikey
apikey: {{master_key}}
Content-Type: application/json

{"apikey_base64":"{{key_to_revoke}}"}
